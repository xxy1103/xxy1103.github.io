---
interface Props {
	draft?: boolean;
	overlay?: boolean;
}

const { draft = false, overlay = false } = Astro.props;
const visible = import.meta.env.DEV && draft;
---

{visible && (
	<span
		class:list={['draft-badge', { 'draft-badge--overlay': overlay }]}
		title="草稿仅在开发环境展示"
		aria-label="草稿"
	>
		草稿
	</span>
)}

<style>
	.draft-badge {
		display: inline-flex;
		align-items: center;
		margin-inline-start: 0.55em;
		padding: 0.18em 0.52em;
		color: var(--accent);
		font-size: 0.68em;
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: 0.08em;
		vertical-align: 0.18em;
		background: color-mix(in srgb, var(--accent) 10%, transparent);
		border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
		border-radius: 999px;
	}

	.draft-badge--overlay {
		margin-inline-start: 0;
		color: white;
		font-size: 0.78rem;
		background: rgba(15, 23, 42, 0.34);
		border-color: rgba(255, 255, 255, 0.58);
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
	}

	@media print {
		.draft-badge {
			display: none;
		}
	}
</style>
