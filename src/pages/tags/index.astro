---
import ArchiveCard from '../../components/ArchiveCard.astro';
import HeroHeader from '../../components/HeroHeader.astro';
import PageShell from '../../layouts/PageShell.astro';
import { heroConfig, siteTitle } from '../../config';
import { getTagStats, getBlogPosts } from '../../lib/content/blog';
import { getTagPath } from '../../lib/content/tag-path';
import { extractExcerpt } from '../../lib/content/text';

const sortedTags = await getTagStats();
const posts = await getBlogPosts();
const tagsHero = heroConfig.tags;
---

<PageShell
  title={`标签 | ${siteTitle}`}
  description="按标签及关键词浏览所有博客文章"
  transparentHeader={true}
  pageId="tags-index"
  useMainWrapper={false}
>
    <style>
      .tags-workspace {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 2.5rem;
        padding-top: 1.5rem;
      }

      /* Left Sidebar / Control Panel */
      .tags-sidebar {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 16px;
        padding: 1.8rem;
        display: flex;
        flex-direction: column;
        gap: 1.8rem;
        height: fit-content;
        position: sticky;
        top: calc(var(--header-height) + 1.5rem);
        max-height: calc(100dvh - var(--header-height) - 3rem);
        overflow: hidden;
        box-shadow: 
          0 10px 30px rgba(var(--shadow-color), 0.04),
          inset 0 1px 0 rgba(255, 255, 255, 0.6);
        transition: var(--theme-transition);
        backdrop-filter: blur(10px);
      }

      /* Search Bar */
      .search-box {
        position: relative;
        display: flex;
        align-items: center;
        flex: 0 0 auto;
      }

      .search-box input {
        width: 100%;
        padding: 0.75rem 1rem 0.75rem 2.5rem;
        border-radius: 12px;
        border: 1px solid var(--color-border);
        background: var(--color-surface-input);
        color: var(--color-text);
        font-size: 0.9rem;
        outline: none;
        transition: all 0.3s cubic-bezier(0.2, 0, 0, 1);
        box-shadow: inset 0 1px 2px rgba(var(--shadow-color), 0.02);
      }

      .search-box input:focus {
        border-color: var(--accent);
        background: var(--color-surface);
        box-shadow: 
          0 0 0 3px rgba(var(--accent-rgb), 0.15),
          0 4px 12px rgba(var(--accent-rgb), 0.05);
      }

      .search-icon {
        position: absolute;
        left: 0.85rem;
        width: 1.1rem;
        height: 1.1rem;
        color: var(--color-text-tertiary);
        pointer-events: none;
        transition: color 0.3s;
      }

      .search-box input:focus + .search-icon {
        color: var(--accent);
      }

      .tag-search-status {
        min-height: 1.1rem;
        margin: -1.15rem 0 0;
        color: var(--color-text-muted);
        font-size: 0.75rem;
        line-height: 1.1rem;
      }

      .sidebar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex: 0 0 auto;
        border-bottom: 1px solid var(--color-border-subtle);
        padding-bottom: 0.75rem;
      }

      .sidebar-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--color-text);
        letter-spacing: 0.5px;
      }

      .tags-count-badge {
        font-size: 0.75rem;
        color: var(--color-text-secondary);
        background: var(--color-surface-hover);
        padding: 2px 8px;
        border-radius: 20px;
        border: 1px solid var(--color-border-subtle);
      }

      .article-search-status {
        margin: 0.35rem 0 0;
        color: var(--color-text-muted);
        font-size: 0.78rem;
        line-height: 1.2;
      }

      /* Weighted Tag Cloud */
      .tags-cloud {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding-right: 0.35rem;
        scrollbar-width: thin;
        scrollbar-color: transparent transparent;
        -webkit-mask-image: linear-gradient(to bottom, transparent, #000 0.7rem, #000 calc(100% - 0.7rem), transparent);
        mask-image: linear-gradient(to bottom, transparent, #000 0.7rem, #000 calc(100% - 0.7rem), transparent);
      }

      .tags-sidebar:hover .tags-cloud,
      .tags-cloud:focus-within {
        scrollbar-color: rgba(var(--accent-rgb), 0.5) transparent;
      }

      .tags-cloud::-webkit-scrollbar {
        width: 5px;
      }

      .tags-cloud::-webkit-scrollbar-thumb {
        border-radius: 999px;
        background: transparent;
      }

      .tags-sidebar:hover .tags-cloud::-webkit-scrollbar-thumb,
      .tags-cloud:focus-within::-webkit-scrollbar-thumb {
        background: rgba(var(--accent-rgb), 0.5);
      }

      .tag-pill {
        display: inline-flex;
        align-items: center;
        padding: 0.4rem 0.8rem;
        border-radius: 8px;
        background: color-mix(in srgb, var(--color-surface-hover) 82%, transparent);
        border: 1px solid var(--color-border-subtle);
        color: var(--color-text-secondary);
        text-decoration: none;
        font-weight: 500;
        line-height: 1.2;
        transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
        cursor: pointer;
        user-select: none;
        opacity: 0;
        animation: fadeInUp 0.5s cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
        animation-delay: calc(var(--i) * 0.03s);
      }

      .tag-pill:hover {
        border-color: rgba(255, 255, 255, 0.4);
        color: white !important;
        transform: translateY(-2px) scale(1.03);
        box-shadow: 
          0 8px 16px -4px rgba(var(--accent-rgb), 0.25),
          inset 0 1px 0 rgba(255, 255, 255, 0.2);
        background: linear-gradient(135deg, var(--accent), #9ba9ff);
      }

      .tag-pill:hover .tag-hash {
        color: white;
      }

      .tag-pill:hover .tag-badge {
        background: rgba(255, 255, 255, 0.25);
        color: white;
      }

      .tag-pill.active-tag {
        color: white !important;
        border-color: transparent;
        background: linear-gradient(135deg, var(--accent), #7b8cff);
        box-shadow: 
          0 8px 20px -4px rgba(var(--accent-rgb), 0.35),
          inset 0 1px 0 rgba(255, 255, 255, 0.2);
        transform: translateY(-1px);
      }

      .tag-pill.active-tag .tag-hash,
      .tag-pill.active-tag .tag-badge {
        color: white;
      }

      .tag-pill.active-tag .tag-badge {
        background: rgba(255, 255, 255, 0.25);
      }

      .tag-hash {
        color: var(--accent);
        margin-right: 0.2rem;
        font-weight: 700;
        transition: color 0.3s;
      }

      .tag-name {
        margin-right: 0.3rem;
      }

      .tag-name mark {
        padding: 0;
        color: inherit;
        background: color-mix(in srgb, var(--accent) 28%, transparent);
        border-radius: 2px;
      }

      .tag-badge {
        font-size: 0.7em;
        background: rgba(var(--shadow-color), 0.04);
        color: var(--color-text-muted);
        padding: 1px 6px;
        border-radius: 20px;
        font-weight: 600;
        transition: all 0.3s;
      }

      /* Right content explorer */
      .posts-explorer {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .explorer-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        border-bottom: 1px solid var(--color-border-subtle);
        padding-bottom: 0.75rem;
      }

      .explorer-title {
        font-size: 1.4rem;
        font-weight: 700;
        margin: 0;
        color: var(--color-text);
        transition: color 0.3s;
      }

      .posts-count-badge {
        font-size: 0.85rem;
        color: var(--color-text-secondary);
        font-weight: 500;
      }

      .tag-posts-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .post-card-wrapper {
        opacity: 0;
        transform: translateY(20px);
        animation: fadeInUp 0.6s cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
        animation-delay: calc(var(--i) * 0.05s);
      }

      /* Premium Card Look */
      .tag-post-item {
        padding: 1.6rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 16px;
        position: relative;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
      }

      .tag-post-item::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        background: linear-gradient(to bottom, var(--accent), #a1c4fd);
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .tag-post-item:hover {
        background: var(--color-surface-hover);
        transform: translateY(-3px);
        box-shadow: 
          0 12px 28px rgba(var(--shadow-color), 0.06),
          0 4px 10px rgba(var(--shadow-color), 0.04);
        border-color: rgba(var(--accent-rgb), 0.18);
      }

      .tag-post-item:hover::before {
        opacity: 1;
      }

      .tag-post-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0 0 0.6rem 0;
        line-height: 1.4;
      }

      .tag-post-title a {
        color: var(--color-text-strong);
        text-decoration: none;
        transition: color 0.2s;
      }

      .tag-post-title a:hover {
        color: var(--accent);
      }

      :global(.tag-post-item .search-highlight) {
        color: var(--color-search-highlight-text);
        background: var(--color-search-highlight-bg);
        border-radius: 2px;
        padding: 0 2px;
      }

      .tag-post-excerpt {
        color: var(--color-text-secondary);
        font-size: 0.92rem;
        line-height: 1.6;
        margin: 0 0 1rem 0;
      }

      .tag-post-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.2rem;
        font-size: 0.82rem;
        color: var(--color-text-tertiary);
        border-top: 1px solid var(--color-border-subtle);
        padding-top: 0.8rem;
      }

      .tag-meta-item {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: color 0.2s;
      }

      .tag-meta-item:hover {
        color: var(--color-text-secondary);
      }

      .tag-meta-item svg {
        width: 14px;
        height: 14px;
        opacity: 0.75;
      }

      .post-item-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-left: auto;
      }

      .post-item-tag-badge {
        font-size: 0.7rem;
        background: var(--color-surface-input);
        border: 1px solid var(--color-border);
        padding: 2px 8px;
        border-radius: 20px;
        color: var(--color-text-secondary);
        transition: all 0.25s;
      }

      .post-item-tag-badge:hover {
        color: var(--accent);
        border-color: rgba(var(--accent-rgb), 0.3);
      }

      /* Empty State */
      .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
        background: var(--color-surface);
        border: 1px dashed var(--color-border);
        border-radius: 16px;
        color: var(--color-text-secondary);
        gap: 1rem;
      }

      .empty-state svg {
        color: var(--color-text-muted);
        opacity: 0.6;
      }

      .empty-state p {
        margin: 0;
        font-size: 0.95rem;
      }

      /* Animations */
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(15px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .animate-fade-in {
        animation: fadeInUp 0.45s cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
      }

      /* Responsive Media Queries */
      @media (max-width: 900px) {
        .tags-workspace {
          grid-template-columns: 1fr;
          gap: 1.8rem;
        }

        .tags-sidebar {
          position: relative;
          top: 0;
          padding: 1.4rem;
          max-height: none;
          overflow: visible;
        }

        .tags-cloud {
          flex: none;
          overflow: visible;
          padding-right: 0;
          overscroll-behavior: auto;
        }
      }

      @media (max-width: 720px) {
        .tags-sidebar {
          border-radius: 12px;
          padding: 1rem;
        }
        
        .tag-post-item {
          padding: 1.2rem;
          border-radius: 12px;
        }

        .post-item-tags {
          width: 100%;
          margin-left: 0;
          margin-top: 0.4rem;
        }
      }
    </style>

  <HeroHeader
    text={tagsHero.text}
    subtitle={tagsHero.subtitle}
    backgroundImage={tagsHero.backgroundImage}
    compact={true}
  />

  <ArchiveCard
    number="Tags"
    title="标签与内容分类"
    intro="选择你感兴趣的主题，或在左侧检索关键字，实时筛选归档文章。"
    minHeight={true}
  >
    {sortedTags.length > 0 ? (
      <div class="tags-workspace">
        {/* Left Column: Sidebar Dashboard */}
        <aside class="tags-sidebar">
          <div class="search-box">
            <input type="text" id="tag-search" placeholder="搜索主题或文章..." autocomplete="off" />
            <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <p id="tag-search-status" class="tag-search-status" aria-live="polite"></p>

          <div class="sidebar-header">
            <span class="sidebar-title">主题清单</span>
            <span class="tags-count-badge">共 {sortedTags.length} 个</span>
          </div>

          <div class="tags-cloud">
            {sortedTags.map(([tag, count], index) => {
              const maxCount = sortedTags[0] ? sortedTags[0][1] : 1;
              const ratio = count / maxCount;
              // Size weight: from 0.85rem to 1.15rem
              const fontSize = 0.85 + ratio * 0.3;
              
              return (
                <a 
                  href={getTagPath(tag)}
                  class="tag-pill" 
                  data-tag={tag}
                  data-count={count}
                  style={`--i: ${index}; font-size: ${fontSize}rem;`}
                >
                  <span class="tag-hash">#</span>
                  <span class="tag-name">{tag}</span>
                  <span class="tag-badge">{count}</span>
                </a>
              );
            })}
          </div>
        </aside>

        {/* Right Column: Dynamic Explorer */}
        <section class="posts-explorer">
          <div class="explorer-header">
            <h3 class="explorer-title" id="active-tag-title">所有文章</h3>
            <span class="posts-count-badge" id="active-posts-count">共 {posts.length} 篇</span>
          </div>
          <p id="article-search-status" class="article-search-status" aria-live="polite"></p>

          <div class="tag-posts-list" id="posts-list">
            {posts.map((post, index) => {
              const excerpt = extractExcerpt(post.body || '', 160);
              return (
                <div 
                  class="post-card-wrapper" 
                  data-post-id={post.id}
                  data-tags={post.data.tags.join(',')}
                  style={`--i: ${index}`}
                >
                  <article class="tag-post-item">
                    <h4 class="tag-post-title">
                      <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                    </h4>
                    {excerpt && <p class="tag-post-excerpt">{excerpt}</p>}
                    
                    <div class="tag-post-meta">
                      <span class="tag-meta-item">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                          <line x1="16" y1="2" x2="16" y2="6"></line>
                          <line x1="8" y1="2" x2="8" y2="6"></line>
                          <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
                      </span>
                      
                      {post.data.categories && post.data.categories.length > 0 && (
                        <span class="tag-meta-item">
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                          </svg>
                          {post.data.categories.join(', ')}
                        </span>
                      )}
                      
                      <div class="post-item-tags">
                        {post.data.tags.map((t: string) => (
                          <span class="post-item-tag-badge">#{t}</span>
                        ))}
                      </div>
                    </div>
                  </article>
                </div>
              );
            })}
          </div>

          <div id="empty-state" class="empty-state" style="display: none;">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="8" y1="12" x2="16" y2="12"></line>
            </svg>
            <p id="empty-state-message">没有找到与搜索或选择匹配的文章</p>
          </div>
        </section>
      </div>
    ) : (
      <p style="text-align: center; color: var(--color-text-secondary); padding: 3rem;">暂无标签</p>
    )}
  </ArchiveCard>

</PageShell>
